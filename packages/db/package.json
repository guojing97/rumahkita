{
  "name": "@rumahkita/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/__tests__/*.test.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:kit": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.35.3",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@rumahkita/typescript-config": "workspace:*",
    "@types/node": "^22.7.5",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.26.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  }
}
